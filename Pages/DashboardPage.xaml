<Page
    x:Class="NSLocker.Ui.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="using:NSLocker.Ui.Controls">

  <ScrollViewer>
    <StackPanel Spacing="16" MaxWidth="980" HorizontalAlignment="Left">
      <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Spacing="4">
          <TextBlock Text="Tableau de bord" Style="{StaticResource TitleTextBlockStyle}" IsTextSelectionEnabled="True"/>
          <TextBlock Text="État des protocoles de résolution de noms exploitables pour l'empoisonnement réseau (Responder, Inveigh)."
                     TextWrapping="Wrap" Opacity="0.7" IsTextSelectionEnabled="True"/>
        </StackPanel>
        <Button Grid.Column="1" VerticalAlignment="Top" Click="Refresh_Click" IsEnabled="{x:Bind Shell.IsIdle, Mode=OneWay}">
          <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72C;" FontSize="14"/><TextBlock Text="Actualiser"/></StackPanel>
        </Button>
      </Grid>

      <ProgressBar IsIndeterminate="True" Visibility="{x:Bind Shell.IsBusy, Mode=OneWay}"/>

      <!-- Six cartes d'état, deux lignes de trois : un clic ouvre la page du module -->
      <Grid ColumnSpacing="12" RowSpacing="12">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Button Tag="mdns" Click="Card_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16">
          <StackPanel Spacing="10"><TextBlock Text="mDNS" FontWeight="SemiBold"/><ctl:StateChip Vm="{x:Bind Shell.Mdns}"/></StackPanel>
        </Button>
        <Button Grid.Column="1" Tag="llmnr" Click="Card_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16">
          <StackPanel Spacing="10"><TextBlock Text="LLMNR" FontWeight="SemiBold"/><ctl:StateChip Vm="{x:Bind Shell.Llmnr}"/></StackPanel>
        </Button>
        <Button Grid.Column="2" Tag="dnssec" Click="Card_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16">
          <StackPanel Spacing="10"><TextBlock Text="DNSSEC" FontWeight="SemiBold"/><ctl:StateChip Vm="{x:Bind Shell.Dnssec}"/></StackPanel>
        </Button>
        <Button Grid.Row="1" Tag="ipv6" Click="Card_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16">
          <StackPanel Spacing="10"><TextBlock Text="IPv6" FontWeight="SemiBold"/><ctl:StateChip Vm="{x:Bind Shell.Ipv6}"/></StackPanel>
        </Button>
        <Button Grid.Row="1" Grid.Column="1" Tag="nbtns" Click="Card_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16">
          <StackPanel Spacing="10"><TextBlock Text="NBT-NS" FontWeight="SemiBold"/><ctl:StateChip Vm="{x:Bind Shell.NbtSummary}"/></StackPanel>
        </Button>
        <Button Grid.Row="1" Grid.Column="2" Tag="ntlm" Click="Card_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16">
          <StackPanel Spacing="10">
            <TextBlock Text="NTLM" FontWeight="SemiBold"/>
            <Border CornerRadius="12" Padding="10,3" BorderThickness="1" HorizontalAlignment="Left"
                    BorderBrush="{x:Bind Shell.Ntlm.Brush, Mode=OneWay}"
                    Background="{ThemeResource ControlFillColorSecondaryBrush}">
              <TextBlock Text="{x:Bind NtlmShortLabel(Shell.Ntlm.Level), Mode=OneWay}"
                         Foreground="{x:Bind Shell.Ntlm.Brush, Mode=OneWay}" FontWeight="SemiBold" FontSize="12"/>
            </Border>
          </StackPanel>
        </Button>
      </Grid>

      <Border Padding="20" CornerRadius="8" BorderThickness="1"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
        <StackPanel Spacing="8">
          <TextBlock Text="À propos" Style="{StaticResource SubtitleTextBlockStyle}"/>
          <TextBlock x:Name="Overview" TextWrapping="Wrap" Opacity="0.8" IsTextSelectionEnabled="True"/>
          <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,8,0,0">
            <TextBlock Text="Auteur :" Opacity="0.6" FontSize="12"/>
            <TextBlock Text="Ayi NEDJIMI — Ayi NEDJIMI Consultants" FontSize="12" IsTextSelectionEnabled="True"/>
          </StackPanel>
          <HyperlinkButton NavigateUri="https://ayinedjimi-consultants.fr" Content="ayinedjimi-consultants.fr"
                            Padding="0" FontSize="12"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Page>
