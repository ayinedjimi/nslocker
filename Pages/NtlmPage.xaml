<Page
    x:Class="NSLocker.Ui.Pages.NtlmPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ScrollViewer>
    <StackPanel Spacing="16" MaxWidth="980" HorizontalAlignment="Left">
      <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Spacing="4">
          <TextBlock Text="NTLM" Style="{StaticResource TitleTextBlockStyle}" IsTextSelectionEnabled="True"/>
          <TextBlock Text="Niveau d'authentification réseau (LAN Manager) — s'applique à tout le poste, pas seulement aux serveurs."
                     TextWrapping="Wrap" Opacity="0.7" IsTextSelectionEnabled="True"/>
        </StackPanel>
        <Button Grid.Column="1" VerticalAlignment="Top" Click="Refresh_Click" IsEnabled="{x:Bind Shell.IsIdle, Mode=OneWay}">
          <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72C;" FontSize="14"/><TextBlock Text="Actualiser"/></StackPanel>
        </Button>
      </Grid>

      <ProgressBar IsIndeterminate="True" Visibility="{x:Bind Shell.IsBusy, Mode=OneWay}"/>

      <StackPanel Orientation="Horizontal" Spacing="16">
        <FontIcon Glyph="{x:Bind CurrentIcon(Shell.Ntlm.IsHardened), Mode=OneWay}"
                  Foreground="{x:Bind CurrentBrush(Shell.Ntlm.IsHardened), Mode=OneWay}"/>
        <TextBlock Text="{x:Bind Shell.Ntlm.Label, Mode=OneWay}" VerticalAlignment="Center" IsTextSelectionEnabled="True"
                   Style="{StaticResource BodyStrongTextBlockStyle}"/>
      </StackPanel>

      <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="Risque de sécurité">
        <InfoBar.Content>
          <TextBlock Text="{x:Bind NtlmRisk}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Margin="0,0,0,8"/>
        </InfoBar.Content>
      </InfoBar>
      <InfoBar IsOpen="True" IsClosable="False" Severity="Warning" Title="Effets de bord possibles">
        <InfoBar.Content>
          <TextBlock Text="{x:Bind NtlmSideEffects}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Margin="0,0,0,8"/>
        </InfoBar.Content>
      </InfoBar>

      <Border Padding="20" CornerRadius="8" BorderThickness="1"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
        <StackPanel Spacing="14">
          <StackPanel Spacing="6">
            <TextBlock Text="Nouveau niveau à appliquer :" FontWeight="SemiBold"/>
            <Slider x:Name="LevelSlider" Minimum="0" Maximum="5" StepFrequency="1" TickFrequency="1"
                    TickPlacement="Outside" SnapsTo="Ticks"
                    Value="{x:Bind Shell.PendingNtlmLevel, Mode=TwoWay}"/>
            <!-- Légende : un numéro par niveau, aligné sous chaque graduation. -->
            <Grid Margin="10,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="0" HorizontalAlignment="Center" FontSize="11" Opacity="0.6"/>
              <TextBlock Grid.Column="1" Text="1" HorizontalAlignment="Center" FontSize="11" Opacity="0.6"/>
              <TextBlock Grid.Column="2" Text="2" HorizontalAlignment="Center" FontSize="11" Opacity="0.6"/>
              <TextBlock Grid.Column="3" Text="3" HorizontalAlignment="Center" FontSize="11" Opacity="0.6"/>
              <TextBlock Grid.Column="4" Text="4" HorizontalAlignment="Center" FontSize="11" Opacity="0.6"/>
              <TextBlock Grid.Column="5" Text="5" HorizontalAlignment="Center" FontSize="11" Opacity="0.6"/>
            </Grid>
            <TextBlock Text="{x:Bind Shell.PendingNtlmLabel, Mode=OneWay}" TextWrapping="Wrap" Opacity="0.85" IsTextSelectionEnabled="True"/>
          </StackPanel>

          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Click="Apply_Click" IsEnabled="{x:Bind Shell.IsIdle, Mode=OneWay}"
                    Style="{StaticResource AccentButtonStyle}" Content="Appliquer"/>
            <Button Click="Script_Click" Content="Script PowerShell"/>
            <ProgressRing IsActive="{x:Bind Shell.IsBusy, Mode=OneWay}" Width="20" Height="20"/>
          </StackPanel>
          <TextBlock Text="{x:Bind NtlmApplyNote}" TextWrapping="Wrap" Opacity="0.6" FontSize="12" IsTextSelectionEnabled="True"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Page>
