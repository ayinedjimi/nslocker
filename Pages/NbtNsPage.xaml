<Page
    x:Class="NSLocker.Ui.Pages.NbtNsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NSLocker.Ui.ViewModels"
    xmlns:ctl="using:NSLocker.Ui.Controls">

  <ScrollViewer>
    <StackPanel Spacing="16" MaxWidth="980" HorizontalAlignment="Left">
      <StackPanel Spacing="4">
        <TextBlock Text="NBT-NS" Style="{StaticResource TitleTextBlockStyle}" IsTextSelectionEnabled="True"/>
        <TextBlock x:Name="Subtitle" TextWrapping="Wrap" Opacity="0.7" IsTextSelectionEnabled="True"/>
      </StackPanel>

      <InfoBar x:Name="RiskBar" IsOpen="True" IsClosable="False" Severity="Informational" Title="Risque de sécurité">
        <InfoBar.Content>
          <TextBlock x:Name="RiskText" TextWrapping="Wrap" IsTextSelectionEnabled="True" Margin="0,0,0,8"/>
        </InfoBar.Content>
      </InfoBar>
      <InfoBar x:Name="SideBar" IsOpen="True" IsClosable="False" Severity="Warning" Title="Effets de bord possibles si désactivé">
        <InfoBar.Content>
          <TextBlock x:Name="SideText" TextWrapping="Wrap" IsTextSelectionEnabled="True" Margin="0,0,0,8"/>
        </InfoBar.Content>
      </InfoBar>

      <TextBlock x:Name="Empty" Text="Aucune interface NetBT trouvée." Visibility="Collapsed"/>

      <!-- Une ligne par carte réseau -->
      <ListView ItemsSource="{x:Bind Shell.Nbt}" SelectionMode="None" IsItemClickEnabled="False">
        <ListView.ItemTemplate>
          <DataTemplate x:DataType="vm:ProtocolVm">
            <Grid ColumnSpacing="10" Padding="0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Spacing="2">
                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True"/>
                <TextBlock Text="{x:Bind Detail, Mode=OneWay}" FontFamily="Consolas" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True"/>
              </StackPanel>
              <ctl:StateChip Grid.Column="1" Vm="{x:Bind}" VerticalAlignment="Center"/>
              <Button Grid.Column="2" Tag="{x:Bind}" Click="Toggle_Click" Content="{x:Bind ActionText, Mode=OneWay}"/>
              <Button Grid.Column="3" Tag="{x:Bind}" Click="Script_Click" Content="PS"/>
            </Grid>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>

      <TextBlock x:Name="Note" TextWrapping="Wrap" Opacity="0.6" FontSize="12" IsTextSelectionEnabled="True"/>
    </StackPanel>
  </ScrollViewer>
</Page>
