<?xml version="1.0" encoding="UTF-8" ?>
<Application
    x:Class="NSLocker.Ui.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
      </ResourceDictionary.MergedDictionaries>
      <!-- Jeux de couleurs sémantiques : une seule source pour les pastilles d'état (clair / sombre suivent le thème Windows). -->
      <SolidColorBrush x:Key="StateOkBrush" Color="#107C10"/>
      <SolidColorBrush x:Key="StateCritBrush" Color="#C42B1C"/>
      <SolidColorBrush x:Key="StateWarnBrush" Color="#9D5D00"/>
    </ResourceDictionary>
  </Application.Resources>
</Application>
