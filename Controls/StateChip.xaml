<UserControl
    x:Class="NSLocker.Ui.Controls.StateChip"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Pastille d'état : icône + libellé, couleur selon l'état (Activé = rouge, Désactivé = vert). -->
  <Border CornerRadius="12" Padding="10,3" BorderThickness="1"
          BorderBrush="{x:Bind Vm.Brush, Mode=OneWay}"
          Background="{ThemeResource ControlFillColorSecondaryBrush}">
    <StackPanel Orientation="Horizontal" Spacing="6">
      <FontIcon Glyph="{x:Bind Vm.Glyph, Mode=OneWay}" FontSize="12" Foreground="{x:Bind Vm.Brush, Mode=OneWay}"/>
      <TextBlock Text="{x:Bind Vm.Label, Mode=OneWay}" Foreground="{x:Bind Vm.Brush, Mode=OneWay}" FontWeight="SemiBold" FontSize="12"/>
    </StackPanel>
  </Border>
</UserControl>
